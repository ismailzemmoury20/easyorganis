{% extends 'base.html.twig' %}

{% block title %}Mes billets{% endblock %}

{% block stylesheets %}
<style>
    .orders-layout { max-width: 1000px; margin: 0 auto; padding: 0 1.5rem; }

    .orders-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-bottom: 2rem; }

    /* Ticket cards */
    .tickets-list { display: flex; flex-direction: column; gap: 1rem; }

    .ticket-card {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 16px;
        overflow: hidden;
        display: grid;
        grid-template-columns: 180px 1fr auto;
        transition: all 0.2s ease;
        position: relative;
    }
    .ticket-card:hover {
        border-color: rgba(139,92,246,0.25);
        box-shadow: 0 8px 32px rgba(0,0,0,0.3);
    }

    /* Left colored strip */
    .ticket-strip {
        background: linear-gradient(180deg, var(--primary) 0%, var(--blue) 100%);
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        padding: 1.5rem 1rem;
        position: relative;
    }
    .ticket-strip::after {
        content: '';
        position: absolute; right: -12px; top: 50%;
        transform: translateY(-50%);
        width: 24px; height: 24px;
        background: var(--bg-deep);
        border-radius: 50%;
        z-index: 2;
    }
    .ticket-strip-inner { text-align: center; color: rgba(255,255,255,0.9); }
    .ticket-event-date-big { font-size: 2.5rem; font-weight: 900; line-height: 1; }
    .ticket-event-month { font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; opacity: 0.8; }
    .ticket-event-year { font-size: 0.7rem; opacity: 0.6; margin-top: 0.125rem; }

    /* Dashed separator */
    .ticket-separator {
        width: 1px;
        background: repeating-linear-gradient(
            to bottom,
            rgba(255,255,255,0.12) 0px,
            rgba(255,255,255,0.12) 6px,
            transparent 6px,
            transparent 12px
        );
        margin: 1rem 0;
        flex-shrink: 0;
    }

    /* Main body */
    .ticket-body {
        padding: 1.5rem;
        display: flex; flex-direction: column; justify-content: center;
    }
    .ticket-event-name {
        font-size: 1.1rem; font-weight: 700;
        color: var(--text); letter-spacing: -0.02em;
        margin-bottom: 0.75rem;
    }
    .ticket-info-row { display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 0.875rem; }
    .ticket-info-item { display: flex; align-items: center; gap: 0.375rem; font-size: 0.8rem; color: var(--text-muted); }
    .ticket-info-item i { color: var(--text-dim); font-size: 0.75rem; }

    .ticket-code-block {
        display: inline-flex; align-items: center; gap: 0.5rem;
        background: rgba(124,58,237,0.08);
        border: 1px solid rgba(124,58,237,0.2);
        border-radius: 8px;
        padding: 0.375rem 0.75rem;
        cursor: pointer;
        transition: all 0.15s ease;
        user-select: all;
    }
    .ticket-code-block:hover {
        background: rgba(124,58,237,0.15);
        border-color: rgba(124,58,237,0.35);
    }
    .ticket-code-text {
        font-family: 'Courier New', monospace;
        font-size: 0.85rem; font-weight: 700;
        color: var(--primary-light);
        letter-spacing: 0.08em;
    }
    .ticket-code-copy { color: var(--text-dim); font-size: 0.8rem; }

    /* Right side – QR / amount */
    .ticket-right {
        padding: 1.5rem;
        display: flex; flex-direction: column;
        align-items: center; justify-content: space-between;
        border-left: 1px dashed rgba(255,255,255,0.1);
        min-width: 140px; text-align: center;
    }

    .qr-placeholder {
        width: 72px; height: 72px;
        background: rgba(255,255,255,0.06);
        border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        font-size: 2rem;
        margin-bottom: 0.625rem;
    }
    .ticket-amount {
        font-size: 1.1rem; font-weight: 800;
        color: var(--amber); letter-spacing: -0.02em;
    }
    .ticket-amount-label { font-size: 0.7rem; color: var(--text-dim); }

    /* Status strip at bottom */
    .ticket-status-bar {
        grid-column: 1 / -1;
        padding: 0.5rem 1.5rem;
        border-top: 1px solid rgba(255,255,255,0.06);
        display: flex; align-items: center; justify-content: space-between;
        background: rgba(255,255,255,0.02);
    }
    .ticket-status-bar-info { font-size: 0.75rem; color: var(--text-dim); display: flex; align-items: center; gap: 0.5rem; }
    .ticket-status-bar-info i { font-size: 0.7rem; }

    /* Used/cancelled card overlay */
    .ticket-card.used   { opacity: 0.6; }
    .ticket-card.canceled { opacity: 0.5; filter: grayscale(0.5); }

    /* Commandes section (orders) */
    .commandes-section {
        margin-top: 2.5rem;
    }
    .commande-row {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 12px; padding: 1.25rem 1.5rem;
        display: flex; align-items: center; gap: 1rem;
        margin-bottom: 0.75rem;
        transition: all 0.15s ease;
    }
    .commande-row:hover { background: rgba(255,255,255,0.05); }
    .commande-icon {
        width: 40px; height: 40px; border-radius: 10px;
        background: rgba(245,158,11,0.1);
        display: flex; align-items: center; justify-content: center;
        font-size: 1.1rem; flex-shrink: 0;
    }
    .commande-info { flex: 1; }
    .commande-event { font-size: 0.9rem; font-weight: 600; color: var(--text); }
    .commande-date  { font-size: 0.78rem; color: var(--text-muted); }
    .commande-amount { font-size: 1rem; font-weight: 800; color: var(--amber); }

    .section-divider {
        display: flex; align-items: center; gap: 1rem;
        margin: 2.5rem 0 1.5rem;
    }
    .section-divider h2 { font-size: 1.1rem; font-weight: 700; color: var(--text); white-space: nowrap; margin: 0; }
    .section-divider::before, .section-divider::after {
        content: ''; flex: 1; height: 1px; background: rgba(255,255,255,0.08);
    }

    .empty-state { text-align: center; padding: 4rem 2rem; }
    .empty-state .empty-icon { font-size: 3rem; margin-bottom: 1rem; }
    .empty-state h3 { font-size: 1.2rem; font-weight: 700; margin-bottom: 0.5rem; }
    .empty-state p { font-size: 0.875rem; color: var(--text-muted); margin-bottom: 1.5rem; }

    @media (max-width: 768px) {
        .ticket-card { grid-template-columns: 120px 1fr; }
        .ticket-right { display: none; }
        .orders-stats { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 500px) {
        .ticket-card { grid-template-columns: 1fr; }
        .ticket-strip { flex-direction: row; padding: 1rem; }
        .orders-stats { grid-template-columns: 1fr; }
    }
</style>
{% endblock %}

{% block body %}
{#
    Variables Twig attendues :
    - tickets : collection de Tickets avec evenement
    - commandes : collection de Commandes avec evenement
    - total_depenses : float
    - tickets_actifs : int
#}
<div class="orders-layout animate-fade-up">

    {# Header #}
    <div class="page-header" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;">
        <div>
            <h1>Mes billets</h1>
            <p>Retrouvez tous vos billets et l'historique de vos commandes</p>
        </div>
        <a href="{{ path('app_acheteur') }}" class="btn-secondary-eo">
            <i class="bi bi-search"></i> Parcourir les événements
        </a>
    </div>

    {# Stats #}
    <div class="orders-stats">
        <div class="stat-card animate-fade-up delay-1">
            <div class="stat-icon" style="background:rgba(124,58,237,0.15);color:var(--primary-light);">
                <i class="bi bi-ticket-perforated"></i>
            </div>
            <div class="stat-value">{{ tickets|length }}</div>
            <div class="stat-label">Total billets</div>
        </div>
        <div class="stat-card animate-fade-up delay-2">
            <div class="stat-icon" style="background:rgba(16,185,129,0.15);color:#34d399;">
                <i class="bi bi-check-circle"></i>
            </div>
            <div class="stat-value">{{ tickets_actifs ?? tickets|filter(t => t.statut == 'actif')|length }}</div>
            <div class="stat-label">Billets actifs</div>
        </div>
        <div class="stat-card animate-fade-up delay-3">
            <div class="stat-icon" style="background:rgba(245,158,11,0.15);color:var(--amber);">
                <i class="bi bi-currency-euro"></i>
            </div>
            <div class="stat-value">
                {% if total_depenses is defined %}
                    {{ total_depenses|number_format(2,'.','') }} €
                {% else %}—{% endif %}
            </div>
            <div class="stat-label">Total dépensé</div>
        </div>
    </div>

    {# ── Tickets section ── #}
    {% if tickets is empty %}
    <div class="empty-state glass-card animate-fade-up delay-2">
        <div class="empty-icon">🎟</div>
        <h3>Aucun billet pour l'instant</h3>
        <p>Explorez les événements disponibles et achetez votre premier billet.</p>
        <a href="{{ path('app_acheteur') }}" class="btn-amber-eo" style="margin:0 auto;display:inline-flex;">
            <i class="bi bi-search"></i> Explorer les événements
        </a>
    </div>
    {% else %}
    <div class="tickets-list">
        {% for ticket in tickets %}
        <div class="ticket-card {{ ticket.statut == 'utilisé' ? 'used' : (ticket.statut == 'annulé' ? 'canceled' : '') }} animate-fade-up" style="animation-delay:{{ loop.index * 0.06 }}s;">
            {# Strip #}
            <div class="ticket-strip">
                <div class="ticket-strip-inner">
                    <div class="ticket-event-date-big">{{ ticket.evenement.date|date('d') }}</div>
                    <div class="ticket-event-month">{{ ticket.evenement.date|date('M') }}</div>
                    <div class="ticket-event-year">{{ ticket.evenement.date|date('Y') }}</div>
                </div>
            </div>

            {# Body #}
            <div class="ticket-body">
                <div class="ticket-event-name">{{ ticket.evenement.nom }}</div>
                <div class="ticket-info-row">
                    <div class="ticket-info-item">
                        <i class="bi bi-clock"></i>
                        {{ ticket.evenement.date|date('H:i') }}
                    </div>
                    <div class="ticket-info-item">
                        <i class="bi bi-geo-alt"></i>
                        {{ ticket.evenement.lieu }}
                    </div>
                    <div class="ticket-info-item">
                        <i class="bi bi-calendar-check"></i>
                        Acheté le {{ ticket.dateAchat|date('d/m/Y') }}
                    </div>
                </div>

                <div class="ticket-code-block" onclick="navigator.clipboard && navigator.clipboard.writeText('{{ ticket.codeUnique }}').then(() => this.querySelector('.ticket-code-copy').textContent = '✓ Copié')">
                    <span class="ticket-code-text">{{ ticket.codeUnique }}</span>
                    <i class="bi bi-copy ticket-code-copy"></i>
                </div>
            </div>

            {# Right panel #}
            <div class="ticket-right">
                <div>
                    <div class="qr-placeholder">📱</div>
                    <div style="font-size:0.68rem;color:var(--text-dim);margin-top:0.25rem;">Scan QR</div>
                </div>
                <div>
                    <div class="ticket-amount">{{ ticket.evenement.prixTicket == 0 ? 'Gratuit' : ticket.evenement.prixTicket ~ ' €' }}</div>
                    <div class="ticket-amount-label">montant</div>
                </div>
            </div>

            {# Status bar #}
            <div class="ticket-status-bar">
                <div class="ticket-status-bar-info">
                    <i class="bi bi-hash"></i>
                    Réf. billet : {{ ticket.id }}
                </div>
                <span class="status-badge {{ ticket.statut == 'actif' ? 'active' : (ticket.statut == 'utilisé' ? 'used' : 'canceled') }}">
                    {{ ticket.statut|capitalize }}
                </span>
            </div>
        </div>
        {% endfor %}
    </div>
    {% endif %}

    {# ── Commandes section ── #}
    {% if commandes is defined and commandes|length > 0 %}
    <div class="commandes-section">
        <div class="section-divider">
            <h2>Historique des commandes</h2>
        </div>

        {% for commande in commandes %}
        <div class="commande-row animate-fade-up" style="animation-delay:{{ loop.index * 0.05 }}s;">
            <div class="commande-icon">🧾</div>
            <div class="commande-info">
                <div class="commande-event">{{ commande.evenement.nom ?? 'Événement' }}</div>
                <div class="commande-date">
                    <i class="bi bi-calendar3" style="font-size:0.7rem;"></i>
                    {{ commande.dateCommande|date('d M Y à H:i') }}
                    &nbsp;·&nbsp;
                    <span class="status-badge {{ commande.statut == 'payé' ? 'active' : (commande.statut == 'en attente' ? 'pending' : 'canceled') }}">
                        {{ commande.statut|capitalize }}
                    </span>
                </div>
            </div>
            <div class="commande-amount">{{ commande.montantTotal|number_format(2,'.','') }} €</div>
        </div>
        {% endfor %}
    </div>
    {% endif %}

</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
// Copy ticket code feedback reset
document.querySelectorAll('.ticket-code-block').forEach(el => {
    el.addEventListener('click', () => {
        const icon = el.querySelector('.ticket-code-copy');
        icon.className = 'bi bi-check2 ticket-code-copy';
        icon.style.color = '#34d399';
        setTimeout(() => {
            icon.className = 'bi bi-copy ticket-code-copy';
            icon.style.color = '';
        }, 2000);
    });
});
</script>
{% endblock %}
