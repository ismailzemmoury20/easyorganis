<!-- Upcoming events -->
<section class="upcoming" id="evenements">
    <div style="max-width:1100px;margin:0 auto;">
        <div class="fade-up" style="display:flex;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;gap:1rem;">
            <div>
                <div class="section-label">Événements à venir</div>
                <h2 class="section-title">Ce qui se passe bientôt</h2>
                <p class="section-subtitle">Découvrez les prochains événements disponibles sur EasyOrganis.</p>
            </div>
            <a href="{{ path('app_register') }}" style="font-size:0.85rem;font-weight:600;color:var(--primary-light);text-decoration:none;display:flex;align-items:center;gap:0.4rem;white-space:nowrap;">
                Voir tout <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div class="events-public-grid">
            {% if prochains is empty %}
            <div class="empty-events fade-up">
                <i class="bi bi-calendar-x"></i>
                Aucun événement à venir pour le moment.<br>
                <a href="{{ path('app_register') }}" style="color:var(--primary-light);text-decoration:none;font-weight:600;">Soyez le premier à en créer un →</a>
            </div>
            {% else %}
            {% for evenement in prochains %}
            <div class="pub-event-card fade-up" style="animation-delay:{{ loop.index * 0.07 }}s;">
                <div class="pub-event-cover">
                    {% if evenement.image %}
                    <img src="{{ asset('uploads/' ~ evenement.image) }}" alt="{{ evenement.nom }}">
                    {% else %}
                    <div class="pub-event-cover-placeholder">🎟</div>
                    {% endif %}
                    <div class="pub-event-cover-overlay"></div>
                    <div class="pub-event-date-badge">
                        <i class="bi bi-calendar3"></i>
                        {{ evenement.date|date('d M Y') }}
                    </div>
                </div>
                <div class="pub-event-body">
                    <div class="pub-event-title">{{ evenement.nom }}</div>
                    <div class="pub-event-meta">
                        <div class="pub-event-meta-item">
                            <i class="bi bi-geo-alt"></i> {{ evenement.lieu }}
                        </div>
                        <div class="pub-event-meta-item">
                            <i class="bi bi-people"></i> {{ evenement.nombresPlaces }} places
                        </div>
                    </div>
                    <div class="pub-event-footer">
                        <div class="pub-event-price">
                            {{ evenement.prixTicket|number_format(0, '.', '') }} €
                            <small> / billet</small>
                        </div>
                        <a href="{{ path('app_login') }}" class="pub-event-cta">
                            <i class="bi bi-ticket-perforated"></i> Acheter
                        </a>
                    </div>
                </div>
            </div>
            {% endfor %}
            {% endif %}
        </div>
    </div>
</section>

