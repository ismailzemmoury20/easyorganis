{% extends 'base.html.twig' %}

{% block title %}Paiement réussi — EasyOrganis{% endblock %}

{% block stylesheets %}
<style>
    .payment-layout {
        max-width: 600px;
        margin: 0 auto;
        padding: 4rem 1.5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .payment-icon {
        width: 88px; height: 88px;
        border-radius: 50%;
        background: rgba(16,185,129,0.12);
        border: 2px solid rgba(16,185,129,0.3);
        display: flex; align-items: center; justify-content: center;
        font-size: 2.5rem;
        margin-bottom: 2rem;
        animation: pop 0.5s cubic-bezier(0.34,1.56,0.64,1) both;
    }
    @keyframes pop {
        from { transform: scale(0); opacity: 0; }
        to   { transform: scale(1); opacity: 1; }
    }

    .payment-title {
        font-size: 1.75rem; font-weight: 800;
        letter-spacing: -0.03em;
        color: var(--text);
        margin-bottom: 0.75rem;
    }

    .payment-subtitle {
        font-size: 1rem;
        color: var(--text-muted);
        line-height: 1.7;
        margin-bottom: 2.5rem;
        max-width: 420px;
    }

    .payment-card {
        width: 100%;
        background: rgba(16,185,129,0.06);
        border: 1px solid rgba(16,185,129,0.2);
        border-radius: 16px;
        padding: 1.5rem;
        margin-bottom: 2rem;
        display: flex;
        align-items: center;
        gap: 1rem;
    }
    .payment-card-icon {
        width: 44px; height: 44px; flex-shrink: 0;
        background: rgba(16,185,129,0.12);
        border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        color: #34d399; font-size: 1.25rem;
    }
    .payment-card-text { text-align: left; }
    .payment-card-label { font-size: 0.75rem; color: var(--text-dim); margin-bottom: 0.2rem; }
    .payment-card-value { font-size: 0.9rem; font-weight: 600; color: var(--text); }

    .payment-actions {
        display: flex; gap: 0.875rem; flex-wrap: wrap; justify-content: center;
    }
</style>
{% endblock %}

{% block body %}
<div class="payment-layout animate-fade-up">

    <div class="payment-icon">✅</div>

    <h1 class="payment-title">Paiement réussi !</h1>
    <p class="payment-subtitle">
        Votre billet a bien été enregistré. Retrouvez votre code unique dans l'espace "Mes billets".
    </p>

    <div class="payment-card">
        <div class="payment-card-icon">
            <i class="bi bi-ticket-perforated-fill"></i>
        </div>
        <div class="payment-card-text">
            <div class="payment-card-label">Statut du paiement</div>
            <div class="payment-card-value" style="color:#34d399;">Confirmé et sécurisé via Stripe</div>
        </div>
    </div>

    <div class="payment-card">
        <div class="payment-card-icon">
            <i class="bi bi-envelope-fill"></i>
        </div>
        <div class="payment-card-text">
            <div class="payment-card-label">Confirmation</div>
            <div class="payment-card-value">Un reçu a été envoyé à votre adresse email</div>
        </div>
    </div>

    <div class="payment-actions">
        <a href="{{ path('app_acheteur_commandes') }}" class="btn-primary-eo">
            <i class="bi bi-ticket-perforated"></i> Voir mes billets
        </a>
        <a href="{{ path('app_acheteur') }}" class="btn-secondary-eo">
            <i class="bi bi-search"></i> Découvrir d'autres événements
        </a>
    </div>

</div>
{% endblock %}
