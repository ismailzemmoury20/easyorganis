{% extends 'base.html.twig' %}

{% block title %}Mes événements{% endblock %}

{% block stylesheets %}
<style>
    .events-layout { max-width: 1100px; margin: 0 auto; padding: 0 1.5rem; }

    .stats-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 2rem; }

    .event-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.25rem; }

    .event-card {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 16px;
        overflow: hidden;
        transition: all 0.2s ease;
        display: flex; flex-direction: column;
    }
    .event-card:hover {
        border-color: rgba(139,92,246,0.35);
        transform: translateY(-2px);
        box-shadow: 0 12px 40px rgba(0,0,0,0.4);
    }

    .event-cover {
        height: 160px;
        background: linear-gradient(135deg, rgba(124,58,237,0.3), rgba(59,130,246,0.3));
        position: relative;
        overflow: hidden;
    }
    .event-cover img {
        width: 100%; height: 100%;
        object-fit: cover; opacity: 0.8;
    }
    .event-cover-overlay {
        position: absolute; inset: 0;
        background: linear-gradient(to bottom, transparent 40%, rgba(6,6,15,0.8));
    }
    .event-cover-badge {
        position: absolute; top: 0.75rem; right: 0.75rem;
    }
    .event-cat {
        font-size: 0.7rem; font-weight: 600;
        letter-spacing: 0.05em;
        background: rgba(0,0,0,0.5);
        color: var(--primary-light);
        border: 1px solid rgba(139,92,246,0.3);
        padding: 0.2rem 0.6rem; border-radius: 999px;
        backdrop-filter: blur(8px);
    }

    .event-body { padding: 1.25rem; flex: 1; display: flex; flex-direction: column; }

    .event-title {
        font-size: 1rem; font-weight: 700;
        color: var(--text); margin-bottom: 0.5rem;
        letter-spacing: -0.02em;
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    }

    .event-meta { display: flex; flex-direction: column; gap: 0.3rem; margin-bottom: 1rem; }
    .event-meta-item {
        display: flex; align-items: center; gap: 0.5rem;
        font-size: 0.8rem; color: var(--text-muted);
    }
    .event-meta-item i { color: var(--text-dim); font-size: 0.75rem; }

    /* Progress bar */
    .tickets-progress { margin-bottom: 1rem; }
    .progress-header {
        display: flex; justify-content: space-between;
        font-size: 0.75rem; margin-bottom: 0.375rem;
    }
    .progress-header span { color: var(--text-muted); }
    .progress-header strong { color: var(--text); font-weight: 600; }
    .progress-track {
        height: 5px;
        background: rgba(255,255,255,0.08);
        border-radius: 999px;
        overflow: hidden;
    }
    .progress-fill {
        height: 100%; border-radius: 999px;
        background: linear-gradient(90deg, var(--primary), var(--blue));
        transition: width 0.8s cubic-bezier(0.22,1,0.36,1);
    }
    .progress-fill.full { background: linear-gradient(90deg, var(--amber), #d97706); }

    .event-footer {
        margin-top: auto; padding-top: 1rem;
        border-top: 1px solid rgba(255,255,255,0.06);
        display: flex; gap: 0.5rem;
    }

    .btn-sm-eo {
        flex: 1;
        font-size: 0.78rem; font-weight: 600;
        padding: 0.45rem 0.75rem;
        border-radius: 8px; cursor: pointer;
        text-decoration: none; text-align: center;
        transition: all 0.15s ease;
        display: flex; align-items: center; justify-content: center; gap: 0.375rem;
    }
    .btn-sm-primary { background: rgba(124,58,237,0.15); color: var(--primary-light); border: 1px solid rgba(124,58,237,0.25); }
    .btn-sm-primary:hover { background: rgba(124,58,237,0.25); color: var(--primary-light); }
    .btn-sm-ghost { background: rgba(255,255,255,0.04); color: var(--text-muted); border: 1px solid rgba(255,255,255,0.08); }
    .btn-sm-ghost:hover { background: rgba(255,255,255,0.08); color: var(--text); }
    .btn-sm-danger { background: rgba(239,68,68,0.08); color: #f87171; border: 1px solid rgba(239,68,68,0.2); }
    .btn-sm-danger:hover { background: rgba(239,68,68,0.15); color: #fca5a5; }
    .btn-sm-success { background: rgba(16,185,129,0.1); color: #34d399; border: 1px solid rgba(16,185,129,0.25); }
    .btn-sm-success:hover { background: rgba(16,185,129,0.2); color: #6ee7b7; }

    .publish-badge {
        display: inline-flex; align-items: center; gap: 0.35rem;
        font-size: 0.68rem; font-weight: 700; letter-spacing: 0.04em;
        padding: 0.2rem 0.6rem; border-radius: 999px;
    }
    .publish-badge.published {
        background: rgba(16,185,129,0.12);
        color: #34d399;
        border: 1px solid rgba(16,185,129,0.25);
    }
    .publish-badge.draft {
        background: rgba(245,158,11,0.1);
        color: var(--amber);
        border: 1px solid rgba(245,158,11,0.25);
    }

    .empty-state {
        text-align: center; padding: 5rem 2rem;
        background: rgba(255,255,255,0.02);
        border: 1px dashed rgba(255,255,255,0.08);
        border-radius: 16px;
    }
    .empty-state .empty-icon { font-size: 3rem; margin-bottom: 1rem; }
    .empty-state h3 { font-size: 1.2rem; font-weight: 700; color: var(--text); margin-bottom: 0.5rem; }
    .empty-state p { font-size: 0.875rem; color: var(--text-muted); margin-bottom: 1.5rem; }

    @media (max-width: 768px) {
        .stats-row { grid-template-columns: repeat(2, 1fr); }
        .event-grid { grid-template-columns: 1fr; }
    }
</style>
{% endblock %}

{% block body %}
<div class="events-layout animate-fade-up">

    {# Header #}
    <div class="page-header" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;">
        <div>
            <h1>Mes événements</h1>
            <p>Gérez et suivez les performances de vos événements</p>
        </div>
        <a href="{{ path('app_organisateur') }}" class="btn-primary-eo">
            <i class="bi bi-plus-lg"></i> Nouvel événement
        </a>
    </div>

    {# Stats #}
    <div class="stats-row">
        <div class="stat-card animate-fade-up delay-1">
            <div class="stat-icon" style="background:rgba(124,58,237,0.15);color:var(--primary-light);">
                <i class="bi bi-calendar3"></i>
            </div>
            <div class="stat-value">{{ total_evenements ?? evenements|length }}</div>
            <div class="stat-label">Événements</div>
        </div>
        <div class="stat-card animate-fade-up delay-2">
            <div class="stat-icon" style="background:rgba(59,130,246,0.15);color:#60a5fa;">
                <i class="bi bi-ticket-perforated"></i>
            </div>
            <div class="stat-value">{{ total_tickets_vendus ?? '—' }}</div>
            <div class="stat-label">Tickets vendus</div>
        </div>
        <div class="stat-card animate-fade-up delay-3">
            <div class="stat-icon" style="background:rgba(245,158,11,0.15);color:var(--amber);">
                <i class="bi bi-currency-euro"></i>
            </div>
            <div class="stat-value">{{ total_revenus is defined ? total_revenus|number_format(0,'.','')|default('0') ~ ' €' : '—' }}</div>
            <div class="stat-label">Revenus totaux</div>
        </div>
        <div class="stat-card animate-fade-up delay-4">
            <div class="stat-icon" style="background:rgba(16,185,129,0.15);color:#34d399;">
                <i class="bi bi-graph-up-arrow"></i>
            </div>
            <div class="stat-value">{{ prochain_evenement is defined and prochain_evenement ? prochain_evenement.date|date('d/m') : '—' }}</div>
            <div class="stat-label">Prochain événement</div>
        </div>
    </div>

    {# Events grid #}
    {% if evenements is empty %}
    <div class="empty-state animate-fade-up delay-2">
        <div class="empty-icon">🎪</div>
        <h3>Aucun événement pour l'instant</h3>
        <p>Créez votre premier événement et commencez à vendre des billets.</p>
        <a href="{{ path('app_organisateur') }}" class="btn-primary-eo" style="margin:0 auto;">
            <i class="bi bi-plus-lg"></i> Créer un événement
        </a>
    </div>
    {% else %}
    <div class="event-grid">
        {% for evenement in evenements %}
        {% set vendus = 0 %}
        {% set total  = evenement.nombresPlaces ?? 0 %}
        {% set pct    = total > 0 ? (vendus / total * 100)|round : 0 %}

        <div class="event-card animate-fade-up" style="animation-delay:{{ loop.index * 0.05 }}s;">
            <div class="event-cover">
                {% if evenement.image %}
                <img src="{{ asset('uploads/' ~ evenement.image) }}" alt="{{ evenement.nom }}">
                {% else %}
                <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:3rem;">🎟</div>
                {% endif %}
                <div class="event-cover-overlay"></div>
                <div class="event-cover-badge" style="display:flex;flex-direction:column;align-items:flex-end;gap:0.35rem;">
                    <span class="event-cat">{{ evenement.categorie ? evenement.categorie.nomCategorie : 'Autre' }}</span>
                    {% if evenement.isPublished %}
                        <span class="publish-badge published"><i class="bi bi-check-circle-fill"></i> Publié</span>
                    {% else %}
                        <span class="publish-badge draft"><i class="bi bi-pencil-fill"></i> Brouillon</span>
                    {% endif %}
                </div>
            </div>

            <div class="event-body">
                <div class="event-title">{{ evenement.nom }}</div>

                <div class="event-meta">
                    <div class="event-meta-item">
                        <i class="bi bi-calendar3"></i>
                        {{ evenement.date|date('d M Y à H:i') }}
                    </div>
                    <div class="event-meta-item">
                        <i class="bi bi-geo-alt"></i>
                        {{ evenement.lieu }}
                    </div>
                    <div class="event-meta-item">
                        <i class="bi bi-tag"></i>
                        {{ evenement.prixTicket ?? '0' }} € / billet
                    </div>
                </div>

                <div class="tickets-progress">
                    <div class="progress-header">
                        <span>{{ vendus }} vendus</span>
                        <strong>{{ total - vendus }} restants</strong>
                    </div>
                    <div class="progress-track">
                        <div class="progress-fill {{ pct >= 100 ? 'full' : '' }}" style="width:{{ pct }}%;"></div>
                    </div>
                </div>

                <div class="event-footer">
                    <a href="{{ path('app_organisateur_evenements_details', {id: evenement.id}) }}" class="btn-sm-eo btn-sm-primary">
                        <i class="bi bi-eye"></i> Détails
                    </a>
                    <a href="{{ path('app_organisateur_modifier', {id: evenement.id}) }}" class="btn-sm-eo btn-sm-ghost">
                        <i class="bi bi-pencil"></i> Modifier
                    </a>
                    {% if not evenement.isPublished %}
                    <a href="{{ path('app_organisateur_publier', {id: evenement.id}) }}"
                       class="btn-sm-eo btn-sm-success"
                       onclick="return confirm('Publier cet événement ? Il sera visible par tous les acheteurs.')">
                        <i class="bi bi-send-fill"></i> Publier
                    </a>
                    {% else %}
                    <button class="btn-sm-eo btn-sm-ghost"
                            style="cursor:pointer;"
                            onclick="copyEventUrl('{{ absolute_url(path('app_public_evenement', {slug: evenement.slug})) }}', this)"
                            title="Copier le lien de partage">
                        <i class="bi bi-share"></i> Partager
                    </button>
                    {% endif %}
                    <a href="{{ path('app_organisateur_supprimer', {id: evenement.id}) }}"
                       class="btn-sm-eo btn-sm-danger"
                       onclick="return confirm('Supprimer cet événement ?')">
                        <i class="bi bi-trash"></i>
                    </a>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
    {% endif %}

</div>

<div id="share-toast" style="position:fixed;bottom:1.5rem;right:1.5rem;
     background:rgba(16,185,129,0.12);border:1px solid rgba(16,185,129,0.3);
     color:#34d399;padding:0.625rem 1rem;border-radius:10px;font-size:0.85rem;
     font-weight:500;display:flex;align-items:center;gap:0.5rem;
     opacity:0;transition:opacity 0.25s ease;pointer-events:none;z-index:9999;">
    <i class="bi bi-check-circle-fill"></i> Lien copié !
</div>
{% endblock %}

{% block javascripts %}
<script>
function copyEventUrl(url, btn) {
    navigator.clipboard.writeText(url).then(() => {
        const icon  = btn.querySelector('i');
        const toast = document.getElementById('share-toast');
        icon.className = 'bi bi-check-lg';
        btn.style.color = '#34d399';
        toast.style.opacity = '1';
        setTimeout(() => {
            icon.className = 'bi bi-share';
            btn.style.color = '';
            toast.style.opacity = '0';
        }, 2200);
    });
}
</script>
{% endblock %}
