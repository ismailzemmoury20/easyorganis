<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Confirmez votre adresse email — EasyOrganis</title>
</head>
<body style="margin:0; padding:0; background-color:#f0edf8; font-family:helvetica,arial,sans-serif;">

    <table width="100%" cellpadding="0" cellspacing="0" border="0"
           style="background-color:#f0edf8; padding:40px 16px;">
        <tr>
            <td align="center">

                <!-- ══ Carte principale ══ -->
                <table width="560" cellpadding="0" cellspacing="0" border="0"
                       style="max-width:560px; background:#ffffff; border-radius:10px; overflow:hidden;
                              box-shadow:0 2px 16px rgba(61,30,138,0.10);">

                    <!-- En-tête violet -->
                    <tr>
                        <td style="background-color:#3d1e8a; padding:32px 40px 28px;">
                            <p style="margin:0; font-size:11px; letter-spacing:2px;
                                      text-transform:uppercase; color:#c4aff5;">
                                Vérification de compte
                            </p>
                            <p style="margin:10px 0 0; font-size:28px; font-weight:bold;
                                      color:#ffffff; line-height:1.2;">
                                <span style="color:#a78bfa;">Easy</span>Organis
                            </p>
                        </td>
                    </tr>

                    <!-- Corps -->
                    <tr>
                        <td style="padding:40px 40px 32px;">

                            <p style="margin:0 0 8px; font-size:20px; font-weight:bold;
                                      color:#1a1a2e;">
                                Confirmez votre adresse email
                            </p>

                            <p style="margin:0 0 24px; font-size:14px; color:#4a4a6a;
                                      line-height:1.6;">
                                Bienvenue sur EasyOrganis&nbsp;! Pour activer votre compte et commencer
                                à réserver vos événements, veuillez confirmer votre adresse email
                                en cliquant sur le bouton ci-dessous.
                            </p>

                            <!-- Bouton CTA -->
                            <table cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td style="background-color:#3d1e8a; border-radius:6px;">
                                        <a href="{{ signedUrl|raw }}"
                                           style="display:inline-block; padding:14px 32px;
                                                  font-size:15px; font-weight:bold;
                                                  color:#ffffff; text-decoration:none;
                                                  letter-spacing:0.3px;">
                                            Confirmer mon email
                                        </a>
                                    </td>
                                </tr>
                            </table>

                            <!-- Avertissement expiration -->
                            <p style="margin:28px 0 0; font-size:12px; color:#7c6fa0;
                                      line-height:1.5;">
                                &#9888;&nbsp; Ce lien est valable&nbsp;
                                <strong>{{ expiresAtMessageKey|trans(expiresAtMessageData, 'VerifyEmailBundle') }}</strong>.
                                Après expiration, vous devrez faire une nouvelle demande de confirmation.
                            </p>

                            <!-- Lien de secours -->
                            <p style="margin:20px 0 0; font-size:11px; color:#a09abf;
                                      line-height:1.6;">
                                Si le bouton ne fonctionne pas, copiez et collez ce lien dans votre navigateur&nbsp;:<br>
                                <span style="color:#5b34c4; word-break:break-all;">{{ signedUrl|raw }}</span>
                            </p>

                        </td>
                    </tr>

                    <!-- Séparateur -->
                    <tr>
                        <td style="padding:0 40px;">
                            <hr style="border:none; border-top:1px solid #ede8f8; margin:0;">
                        </td>
                    </tr>

                    <!-- Pied de page -->
                    <tr>
                        <td style="padding:24px 40px 32px;">
                            <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td>
                                        <p style="margin:0; font-size:12px; color:#a09abf;">
                                            Vous recevez cet email car vous venez de créer un compte
                                            sur EasyOrganis. Si ce n'est pas vous, ignorez simplement
                                            ce message.
                                        </p>
                                    </td>
                                    <td align="right" style="white-space:nowrap; padding-left:16px;">
                                        <p style="margin:0; font-size:13px; font-weight:bold;
                                                  color:#3d1e8a;">
                                            <span style="color:#a78bfa;">Easy</span>Organis
                                        </p>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                </table>
                <!-- fin carte -->

                <!-- Mention légale sous la carte -->
                <p style="margin:20px 0 0; font-size:11px; color:#a09abf; text-align:center;">
                    &copy; {{ "now"|date("Y") }} EasyOrganis &mdash; Tous droits réservés
                </p>

            </td>
        </tr>
    </table>

</body>
</html>
